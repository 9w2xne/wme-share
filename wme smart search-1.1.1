// ==UserScript==
// @name         WME Smart Search
// @namespace    https://github.com/dinkaftac/wme-share
// @version      1.1.1
// @description  Enhances the WME search box to accept coordinates, DMS, Plus Codes, and URLs from multiple map providers.
// @author       dinkaftac
// @match        https://www.waze.com/editor*
// @match        https://www.waze.com/*/editor*
// @match        https://beta.waze.com/editor*
// @match        https://beta.waze.com/*/editor*
// @exclude      https://www.waze.com/*user/editor*
// @exclude      https://www.waze.com/discuss/*
// @run-at       document-start
// @grant        GM_xmlhttpRequest
// @grant        unsafeWindow
// @connect      maps.app.goo.gl
// @connect      goo.gl
// @connect      g.co
// @connect      google.com
// @connect      google.com.my
// @connect      google.com.sg
// @connect      maps.apple
// @connect      maps.apple.com
// @license      MIT
// @supportURL   https://github.com/dinkaftac/wme-share/issues
// @downloadURL  https://raw.githubusercontent.com/dinkaftac/wme-share/main/wme-smart-search.user.js
// @updateURL    https://raw.githubusercontent.com/dinkaftac/wme-share/main/wme-smart-search.user.js
// ==/UserScript==

(function () {
    'use strict';

    const SCRIPT_ID = 'wme-smart-search';
    const NAME = 'WME Smart Search';
    const BOX_ID = 'search-autocomplete';
    let sdk = null;

    // ------------------------------------------------------------------
    // helpers
    // ------------------------------------------------------------------
    const num = x => parseFloat(String(x).replace(',', '.'));
    const coordOk = (la, lo) => isFinite(la) && isFinite(lo) && Math.abs(la) <= 90 && Math.abs(lo) <= 180 && !(la === 0 && lo === 0);
    const clampZoom = z => Math.max(12, Math.min(22, Math.round(z)));

    function result(lat, lon, zoom, src) {
        lat = num(lat); lon = num(lon);
        if (!coordOk(lat, lon)) return null;
        return { lat, lon, zoom: zoom ? clampZoom(+zoom) : 17, src };
    }

    // ------------------------------------------------------------------
    // Plus Codes (Open Location Code), decoded locally
    // ------------------------------------------------------------------
    const OLC = '23456789CFGHJMPQRVWX';
    const OLC_RES = [20, 1, 0.05, 0.0025, 0.000125];

    function decodePlusCode(code, center) {
        code = code.trim().toUpperCase();
        const sep = code.indexOf('+');
        if (sep < 2 || sep > 8 || sep % 2 === 1) return null;
        const digits = code.replace('+', '');
        for (const ch of digits) if (OLC.indexOf(ch) < 0) return null;

        const pad = 8 - sep;
        let lat = -90, lon = -180, refLat, refLon;
        if (pad > 0) {
            if (!center) return null;
            refLat = center.lat; refLon = center.lon;
            const res = OLC_RES[pad / 2 - 1];
            lat = Math.floor((refLat + 90) / res) * res - 90;
            lon = Math.floor((refLon + 180) / res) * res - 180;
        }
        let latRes = 0, lonRes = 0;
        const pairCount = Math.min(digits.length, 10 - pad);
        for (let i = 0; i < pairCount; i++) {
            const pos = i + pad, res = OLC_RES[Math.floor(pos / 2)], val = OLC.indexOf(digits[i]);
            if (pos % 2 === 0) { lat += val * res; latRes = res; } else { lon += val * res; lonRes = res; }
        }
        let gLat = OLC_RES[4], gLon = OLC_RES[4];
        for (let i = pairCount; i < digits.length; i++) {
            const val = OLC.indexOf(digits[i]);
            gLat /= 5; gLon /= 4;
            lat += Math.floor(val / 4) * gLat;
            lon += (val % 4) * gLon;
            latRes = gLat; lonRes = gLon;
        }
        lat += latRes / 2; lon += lonRes / 2;
        if (pad > 0) {
            const res = OLC_RES[pad / 2 - 1], half = res / 2;
            if (lat > refLat + half && lat - res >= -90) lat -= res;
            else if (lat < refLat - half && lat + res <= 90) lat += res;
            if (lon > refLon + half) lon -= res;
            else if (lon < refLon - half) lon += res;
        }
        lat = Math.max(-90, Math.min(90, lat));
        if (lon > 180) lon -= 360; else if (lon < -180) lon += 360;
        const len = digits.length + pad;
        return result(lat, lon, len >= 10 ? 18 : len >= 8 ? 16 : 12, 'Plus Code');
    }

    // ------------------------------------------------------------------
    // Geohash (used by Waze app share links), decoded locally
    // ------------------------------------------------------------------
    const GH = '0123456789bcdefghjkmnpqrstuvwxyz';

    function decodeGeohash(hash) {
        hash = String(hash).toLowerCase();
        let lat = [-90, 90], lon = [-180, 180], even = true;
        for (const ch of hash) {
            const v = GH.indexOf(ch);
            if (v < 0) return null;
            for (let b = 4; b >= 0; b--) {
                const r = even ? lon : lat, mid = (r[0] + r[1]) / 2;
                if ((v >> b) & 1) r[0] = mid; else r[1] = mid;
                even = !even;
            }
        }
        const len = hash.length;
        return result((lat[0] + lat[1]) / 2, (lon[0] + lon[1]) / 2, len >= 8 ? 18 : len >= 6 ? 16 : 13, 'Waze share link');
    }

    // ------------------------------------------------------------------
    // URL parsing
    // ------------------------------------------------------------------
    function parseUrl(url) {
        let d = url.trim();
        try { d = decodeURIComponent(d); } catch (e) { /* keep raw */ }
        const host = (/^[a-z][a-z0-9+.-]*:\/\/([^\/?#]+)/i.exec(d) || [])[1] || '';
        let m;
        const q = (re) => (re.exec(d) || [])[1];

        if ((m = /^geo:(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/i.exec(d))) return result(m[1], m[2], q(/[?&]z=(\d+)/), 'geo:');

        if (/^(maps\.app\.goo\.gl|goo\.gl|g\.co|maps\.apple)$/i.test(host) && !/[?&](?:ll|coordinate|sll|q)=-?\d/.test(d))
            return { short: url.trim() };

        // Waze app share link: waze.com/ul/h<geohash> (also the legacy meetup/location?h=<geohash>)
        if (/(^|\.)waze\.(com|to)$/i.test(host)
            && (m = /\/ul\/h([0-9bcdefghjkmnpqrstuvwxyz]{4,12})(?:[\/?#]|$)/i.exec(d) || /[?&]h=([0-9bcdefghjkmnpqrstuvwxyz]{4,12})(?:&|$)/i.exec(d))) {
            const g = decodeGeohash(m[1]);
            if (g) return g;
        }

        if (/yandex\./i.test(host)) {
            m = /[?&]pt=(-?\d+\.\d+),(-?\d+\.\d+)/.exec(d) || /[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)/.exec(d);
            if (m) return result(m[2], m[1], q(/[?&]z=(\d+)/), 'Yandex');
        }
        if (/here\.com$/i.test(host)) {
            m = /[?&]map=(-?\d+\.\d+),(-?\d+\.\d+)(?:,(\d+(?:\.\d+)?))?/.exec(d) || /here\.com\/l\/(-?\d+\.\d+),(-?\d+\.\d+)/.exec(d);
            if (m) return result(m[1], m[2], m[3], 'HERE');
        }
        if (/bing\.com$/i.test(host) && (m = /[?&]cp=(-?\d+\.\d+)~(-?\d+\.\d+)/.exec(d))) return result(m[1], m[2], q(/[?&]lvl=(\d+)/), 'Bing');
        if (/openstreetmap\.org$/i.test(host)) {
            const z = /map=(\d+)\/(-?\d+\.\d+)\/(-?\d+\.\d+)/.exec(d);
            m = /[?&]mlat=(-?\d+\.\d+)&mlon=(-?\d+\.\d+)/.exec(d);
            if (m) return result(m[1], m[2], z && z[1], 'OpenStreetMap');
            if (z) return result(z[2], z[3], z[1], 'OpenStreetMap');
        }
        if ((m = /#(-?\d+\.\d+),(-?\d+\.\d+),(\d+(?:\.\d+)?)z/.exec(d))) return result(m[1], m[2], m[3], host);

        if ((m = /!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/.exec(d))) return result(m[1], m[2], 18, 'Google Maps');
        if ((m = /@(-?\d+\.\d+),(-?\d+\.\d+)(?:,(\d+(?:\.\d+)?)z)?/.exec(d))) return result(m[1], m[2], m[3] || 17, 'Google Maps');
        if ((m = /\/maps\/(?:search|place|dir)\/(?:[^\/]*\/)?(-?\d+\.\d+),\s*\+?(-?\d+\.\d+)/.exec(d))) return result(m[1], m[2], 18, 'Google Maps');

        if ((m = /[?&](?:q|query|ll|center|destination|daddr|coordinate|sll|cbll|latlng)=\s*(-?\d+\.\d+)\s*,\s*\+?(-?\d+\.\d+)/.exec(d)))
            return result(m[1], m[2], q(/[?&](?:zoomLevel|zoom|z|lvl|level)=(\d+)/), host.replace(/^www\./, ''));

        const la = q(/[?&](?:lat|latitude|y)=(-?\d+\.?\d*)/i), lo = q(/[?&](?:lon|lng|long|longitude|x)=(-?\d+\.?\d*)/i);
        if (la && lo) return result(la, lo, q(/[?&](?:zoomLevel|zoom|z|lvl|level)=(\d+)/), host.replace(/^www\./, ''));
        return null;
    }

    // ------------------------------------------------------------------
    // Text parsing
    // ------------------------------------------------------------------
    function parseDms(s) {
        // groups: 1 hemisphere (prefix), 2 minus sign, 3 degrees, 4 minutes, 5 seconds, 6 hemisphere (suffix)
        const re = /([NSEWO])?\s*([-\u2212])?\s*(\d{1,3}(?:[.,]\d+)?)\s*[°º]\s*(?:(\d{1,2}(?:[.,]\d+)?)\s*['′’]\s*)?(?:(\d{1,2}(?:[.,]\d+)?)\s*(?:["″”]|'')\s*)?([NSEWO])?/gi;
        const v = [];
        let m;
        while ((m = re.exec(s)) && v.length < 3) {
            if (!m[0].trim()) { re.lastIndex++; continue; }
            const f = x => x ? num(x) : 0;
            const h = (m[1] || m[6] || '').toUpperCase();
            let deg = f(m[3]) + f(m[4]) / 60 + f(m[5]) / 3600;
            if (m[2] || h === 'S' || h === 'W' || h === 'O') deg = -deg;
            v.push({ deg, h });
        }
        if (v.length !== 2) return null;
        let [a, b] = v;
        if ('EWO'.includes(a.h || '-') && 'NS'.includes(b.h || '-')) [a, b] = [b, a];
        const r = result(a.deg, b.deg, 18, 'DMS');
        if (r && !a.h && !b.h && Math.abs(a.deg) <= 90 && Math.abs(b.deg) <= 90 && a.deg !== b.deg) {
            const alt = result(b.deg, a.deg, 18, 'DMS (lon, lat)');
            if (alt) r.alt = alt;
        }
        return r;
    }

    function parseDecimal(s) {
        let m = /^(-?\d{1,3}\.\d+)\s*([NSEWO])?\s*[,;\s]\s*(-?\d{1,3}\.\d+)\s*([NSEWO])?$/i.exec(s)
            || /^(-?\d{1,3},\d+)\s*([NSEWO])?\s*[;\s]\s*(-?\d{1,3},\d+)\s*([NSEWO])?$/i.exec(s);
        if (!m) {
            const p = /^([NSEWO])\s*(-?\d{1,3}[.,]\d+)\s*[,;\s]\s*([NSEWO])\s*(-?\d{1,3}[.,]\d+)$/i.exec(s);
            if (p) m = [p[0], p[2], p[1], p[4], p[3]];
        }
        if (!m) return null;
        const sign = (v, h) => /[SWO]/i.test(h || '') ? -Math.abs(v) : v;
        let a = sign(num(m[1]), m[2]), b = sign(num(m[3]), m[4]);
        const hA = (m[2] || '').toUpperCase(), hB = (m[4] || '').toUpperCase();
        if ('EWO'.includes(hA || '-') && 'NS'.includes(hB || '-')) [a, b] = [b, a];
        if (Math.abs(a) > 90 && Math.abs(b) <= 90) [a, b] = [b, a];
        const r = result(a, b, 18, 'Coordinates');
        // both numbers could be either lat or lon: offer the reversed reading too
        if (r && !hA && !hB && Math.abs(a) <= 90 && Math.abs(b) <= 90 && a !== b) {
            const alt = result(b, a, 18, 'Coordinates (lon, lat)');
            if (alt) r.alt = alt;
        }
        return r;
    }

    function mapCenter() {
        try { const c = sdk.Map.getMapCenter(); return { lat: c.lat, lon: c.lon }; } catch (e) { return null; }
    }

    // Returns {lat,lon,zoom,src,alt?}, {short:url}, or null
    function parseInput(raw) {
        const s = (raw || '').trim();
        if (!s || s.length > 2000) return null;

        // Every supported input (coordinates, DMS, Plus Code, URL) contains a digit.
        // Plain sentences with spaces are ignored so ordinary searches are never touched.
        if (s.includes(' ') && !/\d/.test(s)) return null;

        if (/^(www\.|ul\.)?waze\.(com|to)\/\S+$/i.test(s)) return parseUrl('https://' + s);   // Waze link pasted without https://
        if (/^(https?:\/\/|geo:)/i.test(s)) return parseUrl(s);
        const link = /(https?:\/\/\S+|geo:\S+)/i.exec(s);   // a link buried in other text
        if (link) return parseUrl(link[1]);
        const tok = s.split(/\s+/)[0];
        if (/^[23456789CFGHJMPQRVWX]{2,8}\+[23456789CFGHJMPQRVWX]{0,7}$/i.test(tok)) return decodePlusCode(tok, mapCenter());
        if (/[°º]/.test(s)) return parseDms(s);
        return parseDecimal(s);
    }

    // ------------------------------------------------------------------
    // Map actions + marker
    // ------------------------------------------------------------------
    let layerReady = false;
    function drawMarker(lat, lon) {
        try {
            if (!layerReady) {
                sdk.Map.addLayer({ layerName: NAME, styleRules: [{ style: { strokeColor: '#e53935', strokeWidth: 3, fillColor: '#e53935', fillOpacity: 0.45, pointRadius: 11 } }] });
                layerReady = true;
            }
            sdk.Map.removeAllFeaturesFromLayer({ layerName: NAME });
            sdk.Map.addFeaturesToLayer({ layerName: NAME, features: [{ type: 'Feature', id: 'wss-pin', geometry: { type: 'Point', coordinates: [lon, lat] }, properties: {} }] });
        } catch (e) { console.log('[WSS] marker: ' + e.message); }
    }
    function clearMarker() {
        try { if (layerReady) sdk.Map.removeAllFeaturesFromLayer({ layerName: NAME }); } catch (e) { /* ignore */ }
    }
    // ------------------------------------------------------------------
    // Search box wiring
    // ------------------------------------------------------------------
    const dbg = (...a) => {
        try { if (localStorage.getItem('wss-debug') === '1') console.log('[WSS]', ...a); } catch (e) { /* ignore */ }
    };

    // b = { host, inner }: the search box element and the real <input> inside it (if reachable).
    // After a jump, empty the box and tell WME the text changed so it closes its suggestion list.
    function clearBox(b) {
        setTimeout(() => {
            try {
                b.host.value = '';
                const i = b.inner || (b.host.shadowRoot && b.host.shadowRoot.querySelector('input'));
                if (i) {
                    i.value = '';
                    i.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
                }
            } catch (e) { /* ignore */ }
        }, 60);
    }

    // ------------------------------------------------------------------
    // Own search panel: a small draggable window with its own input box.
    // It never touches the WME search box, so WME cannot pick a suggestion over it.
    // ------------------------------------------------------------------
    const HOOK_WME_BOX = false;   // set true to also intercept paste/Enter in the WME search box itself
    const POS_KEY = 'wme-smart-search:bar-pos';
    const MIN_KEY = 'wme-smart-search:panel-min';
    let panel = null, inputEl = null;

    const store = {
        get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
        set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* ignore */ } }
    };

    function placePanel(left, top) {
        const w = panel.offsetWidth || 300, h = panel.offsetHeight || 40;
        left = Math.max(0, Math.min(window.innerWidth - w, left));
        top = Math.max(0, Math.min(window.innerHeight - h, top));
        panel.style.left = left + 'px';
        panel.style.top = top + 'px';
        return { left, top };
    }

    function restorePos() {
        let p = null;
        try { p = JSON.parse(store.get(POS_KEY)); } catch (e) { /* corrupt */ }
        if (p && isFinite(p.left) && isFinite(p.top)) placePanel(p.left, p.top);
        else placePanel((window.innerWidth - (panel.offsetWidth || 400)) / 2, 60);   // first run: top centre
    }

    // Drag from the pin (the grip) or from any empty part of the bar. A press on the pin that does not move
    // counts as a click and collapses/opens the bar. Inputs, buttons and links never start a drag.
    function makeDraggable(handle, grip, onGripClick) {
        handle.addEventListener('pointerdown', ev => {
            const onGrip = ev.target === grip;
            if (ev.button !== 0 || (!onGrip && ev.target.closest && ev.target.closest('button,input,a,b'))) return;
            const rect = panel.getBoundingClientRect();
            const dx = ev.clientX - rect.left, dy = ev.clientY - rect.top;
            const x0 = ev.clientX, y0 = ev.clientY;
            let pos = null, moved = false;
            const move = e => {
                if (!moved && Math.abs(e.clientX - x0) + Math.abs(e.clientY - y0) < 4) return;   // ignore tiny jitter
                moved = true;
                pos = placePanel(e.clientX - dx, e.clientY - dy);
            };
            const up = () => {
                document.removeEventListener('pointermove', move);
                document.removeEventListener('pointerup', up);
                if (pos) store.set(POS_KEY, JSON.stringify(pos));
                if (onGrip && !moved && onGripClick) onGripClick();
            };
            document.addEventListener('pointermove', move);
            document.addEventListener('pointerup', up);
            ev.preventDefault();
        });
    }

    // The bar is one row, about the height of the WME search box:
    //   [pin] [input........] [Go] [swap]  [result or message]
    function setInfo(node, bad) {
        if (!infoEl) return;
        clearTimeout(infoTimer);
        while (infoEl.firstChild) infoEl.removeChild(infoEl.firstChild);
        if (node) infoEl.appendChild(node);
        infoEl.style.color = bad ? '#ff8a80' : '#fff';
        infoEl.style.display = (node && !collapsed) ? 'inline-flex' : 'none';
        if (node) { infoTimer = setTimeout(() => setInfo(null), AUTO_CLOSE_MS); startIdle(); }
    }

    function setStatus(msg, bad) {
        if (!msg) { setInfo(null); return; }
        const t = document.createElement('span');
        t.textContent = msg;
        setInfo(t, bad);
    }

    function setResult(r) {
        const lat = r.lat.toFixed(6), lon = r.lon.toFixed(6), text = lat + ', ' + lon;
        const wrap = document.createElement('span');
        wrap.style.cssText = 'display:inline-flex;align-items:center;gap:8px;white-space:nowrap';
        const src = document.createElement('span');
        src.textContent = (r.src || 'Location') + ':';
        src.style.color = '#b0bec5';
        const coord = document.createElement('b');
        coord.textContent = text;
        coord.style.userSelect = 'all';
        const copy = document.createElement('button');
        copy.textContent = 'Copy';
        copy.title = 'Copy lat, lon';
        copy.style.cssText = LINK_CSS + ';background:none;border:0;padding:0;cursor:pointer';
        copy.onclick = () => {
            try { navigator.clipboard.writeText(text).then(() => { copy.textContent = 'Copied'; }, () => { copy.textContent = 'Failed'; }); }
            catch (e) { copy.textContent = 'Failed'; }
        };
        const link = (txt, title, href) => {
            const a = document.createElement('a');
            a.textContent = txt; a.title = title; a.href = href; a.target = '_blank'; a.rel = 'noopener noreferrer';
            a.style.cssText = LINK_CSS;
            return a;
        };
                const closeBtn = document.createElement('button');
        closeBtn.textContent = '✕';
        closeBtn.title = 'Close (Esc)';
        closeBtn.style.cssText = 'background:none;border:0;padding:0 4px 0 0;cursor:pointer;color:#b0bec5;font:inherit;flex:none';
        closeBtn.onclick = () => { setInfo(null); clearMarker(); };
        wrap.appendChild(closeBtn);
        wrap.appendChild(src); wrap.appendChild(coord); wrap.appendChild(copy);
        wrap.appendChild(link('Waze', 'Open in Waze Live Map', 'https://www.waze.com/live-map?zoom=18&lat=' + lat + '&lon=' + lon));
        wrap.appendChild(link('Google', 'Open in Google Maps', 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lon));
        setInfo(wrap, false);
    }
    const AUTO_CLOSE_MS = 7000;   // how long the result strip stays open (6000-8000 works well)
    let infoTimer = null;
    const AUTO_COLLAPSE_MS = 20000;   // idle time before the bar shrinks to just the pin
    let idleTimer = null;
    function startIdle() {
        clearTimeout(idleTimer);
        if (collapsed) return;
        idleTimer = setTimeout(() => {
            if (document.activeElement === inputEl && inputEl.value) { startIdle(); return; }   // still typing
            setMinimised(true);
        }, AUTO_COLLAPSE_MS);
    }
    const LINK_CSS = 'color:#80d8ff;text-decoration:underline;font:inherit';
    const BTN_CSS = 'height:26px;padding:0 9px;border:0;border-radius:4px;background:#0288d1;color:#fff;cursor:pointer;font:inherit;flex:none';

    // Collapse the bar to just the pin (click the pin again to open it).
    function setMinimised(min) {
        if (!panel) return;
        collapsed = min;
        [inputEl, goBtn, swapBtn].forEach(el => { el.style.display = min ? 'none' : ''; });
        infoEl.style.display = (min || !infoEl.firstChild) ? 'none' : 'inline-flex';
        pinBtn.title = min ? 'Click to open, drag to move' : 'Drag to move, click to collapse';
        store.set(MIN_KEY, min ? '1' : '0');
        if (min) clearTimeout(idleTimer); else startIdle();
        placePanel(parseFloat(panel.style.left) || 0, parseFloat(panel.style.top) || 0);   // keep it on screen
    }

    // Parse what is in the input and jump. swap = read an ambiguous pair as lon, lat.
    function submit(swap) {
        const text = (inputEl.value || '').trim();
        if (!text) { setStatus('Paste coordinates, a Plus Code or a map link', false); return; }
        const r = parseInput(text);
        dbg('panel', JSON.stringify(text.slice(0, 80)), r ? 'recognised' : 'not recognised');
        if (!r) { setStatus('Not recognised: ' + text.slice(0, 40), true); return; }
        if (r.short) setStatus('Opening short link…', false); else setStatus('', false);
        run(r, swap);
    }

    let goBtn = null, swapBtn = null, pinBtn = null, infoEl = null, collapsed = false;

    function buildPanel() {
        if (panel || !document.body) return;
        panel = document.createElement('div');
        panel.id = 'wss-panel';
        panel.style.cssText = 'position:fixed;top:60px;left:20px;z-index:100000;box-sizing:border-box;height:38px;max-width:96vw;display:flex;align-items:center;gap:6px;padding:0 8px;background:#263238;color:#fff;font:13px/1.2 sans-serif;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.4);cursor:move;touch-action:none;white-space:nowrap';

        // The pin is the drag grip: full bar height so it is easy to grab; a click (no movement) collapses the bar.
        pinBtn = document.createElement('span');
        pinBtn.textContent = '📍';
        pinBtn.style.cssText = 'align-self:stretch;display:flex;align-items:center;padding:0 6px 0 2px;margin-left:-2px;cursor:grab;font-size:16px;line-height:1;flex:none;user-select:none';

        inputEl = document.createElement('input');
        inputEl.type = 'text';
        inputEl.placeholder = 'lat, lon • Plus Code • map link';
        inputEl.autocomplete = 'off';
        inputEl.spellcheck = false;
        inputEl.style.cssText = 'box-sizing:border-box;height:26px;width:230px;min-width:80px;flex:0 1 230px;padding:0 8px;border:1px solid #546e7a;border-radius:4px;background:#37474f;color:#fff;font:inherit;cursor:text';

        goBtn = document.createElement('button');
        goBtn.textContent = 'Go';
        goBtn.title = 'Go to the location (Enter)';
        swapBtn = document.createElement('button');
        swapBtn.textContent = '⇄';
        swapBtn.title = 'Read as lon, lat instead (Shift+Enter)';
        [goBtn, swapBtn].forEach(b => { b.style.cssText = BTN_CSS; });
        goBtn.onclick = () => submit(false);
        swapBtn.onclick = () => submit(true);

        infoEl = document.createElement('span');
        infoEl.style.cssText = 'display:none;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0';

        [pinBtn, inputEl, goBtn, swapBtn, infoEl].forEach(el => panel.appendChild(el));

        // Keep key presses inside the bar away from WME's keyboard shortcuts.
        ['keydown', 'keyup', 'keypress'].forEach(t => panel.addEventListener(t, e => e.stopPropagation()));
        inputEl.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); submit(e.shiftKey); }
        });
        inputEl.addEventListener('keydown', e => {
            if (e.key === 'Escape') { setInfo(null); clearMarker(); }
        });
        inputEl.addEventListener('input', () => { if (infoEl.firstChild) setInfo(null); });
        inputEl.addEventListener('paste', e => {
            const text = (e.clipboardData && e.clipboardData.getData('text')) || '';
            const r = parseInput(text);
            if (!r) return;                   // normal paste, press Enter to see why it is not recognised
            e.preventDefault();
            inputEl.value = text.trim();
            if (r.short) setStatus('Opening short link…', false); else setStatus('', false);
            run(r, false);
        });

        ['pointerenter', 'pointerdown', 'keydown', 'input'].forEach(t => panel.addEventListener(t, startIdle));
        makeDraggable(panel, pinBtn, () => setMinimised(!collapsed));
        document.body.appendChild(panel);
        setMinimised(store.get(MIN_KEY) === '1');
        restorePos();
        window.addEventListener('resize', () => placePanel(parseFloat(panel.style.left) || 0, parseFloat(panel.style.top) || 0));
    }

    function apply(r) {
        if (!sdk) { setStatus('WME is still loading, try again in a moment', true); return; }
        try {
            sdk.Map.setMapCenter({ lonLat: { lat: r.lat, lon: r.lon }, zoomLevel: r.zoom });
        } catch (e) { setStatus('Could not move the map: ' + e.message, true); return; }
        drawMarker(r.lat, r.lon);
        setResult(r);
    }

    function run(r, swap) {
        if (!r) return;
        if (r.short) {
            GM_xmlhttpRequest({
                method: 'GET', url: r.short, timeout: 10000,
                anonymous: true,   // do not send the user's Google/Apple cookies
                onload: res => {
                    const final = res.finalUrl || r.short;
                    const p = parseUrl(final);
                    if (p && !p.short) { setStatus('', false); apply(p); return; }
                    const t = res.responseText || '';   // Apple short pages carry place:location meta tags
                    const la = /place:location:latitude"\s+content="(-?\d+\.?\d*)"/.exec(t), lo = /place:location:longitude"\s+content="(-?\d+\.?\d*)"/.exec(t);
                    if (la && lo) { setStatus('', false); apply(result(la[1], lo[1], 18, 'Apple Maps')); return; }
                    setStatus('No coordinates found in that short link', true);
                },
                onerror: () => setStatus('Could not open the short link', true),
                ontimeout: () => setStatus('Short link timed out', true)
            });
            return;
        }
        if (swap && r.alt) { r.alt.alt = { lat: r.lat, lon: r.lon, zoom: r.zoom, src: r.src }; r = r.alt; }
        apply(r);
    }

    // The listeners sit on window (capture phase) and check where each event came from, instead of being
    // attached to the search box itself. That way they run before WME's own handlers, still work if WME
    // re-renders the box, and do not depend on the SDK or on WME being "ready" before they are installed.
    function searchBoxOf(e) {
        const path = e.composedPath ? e.composedPath() : [];
        const host = path.find(n => n && n.id === BOX_ID);
        if (!host) return null;
        const first = path[0];
        const inner = (first && first !== host && 'value' in first) ? first
            : ((host.shadowRoot && host.shadowRoot.querySelector('input')) || null);
        return { host, inner };
    }

    const boxText = b => (b.inner && b.inner.value) || b.host.value || '';

    function stop(e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
    }

    let swallowEnter = false;   // true from an intercepted Enter keydown until its keyup

    function onKey(e) {
        if (e.key !== 'Enter' || e.isComposing) return;
        const b = searchBoxOf(e);
        if (!b) return;
        if (e.type === 'keydown') {
            const text = boxText(b), r = parseInput(text);
            dbg('Enter', JSON.stringify(text.slice(0, 80)), r ? 'recognised: ' + r.src : 'not recognised, WME search continues');
            swallowEnter = !!r;
            if (!r) return;                 // normal WME search continues
            stop(e);
            run(r, e.shiftKey);             // Shift+Enter = use the reversed lon, lat reading
            clearBox(b);
        } else if (swallowEnter) {          // keypress / keyup of the same Enter: keep WME from acting on it
            stop(e);
            if (e.type === 'keyup') swallowEnter = false;
        }
    }

    function onPaste(e) {
        const b = searchBoxOf(e);
        if (!b) return;
        const text = (e.clipboardData && e.clipboardData.getData('text')) || '';
        const r = parseInput(text);
        dbg('paste', JSON.stringify(text.slice(0, 80)), r ? 'recognised: ' + r.src : 'not recognised, normal paste');
        if (!r) return;                     // normal paste continues
        stop(e);
        run(r, false);
        clearBox(b);
    }

    if (HOOK_WME_BOX) {
        ['keydown', 'keypress', 'keyup'].forEach(t => window.addEventListener(t, onKey, true));
        window.addEventListener('paste', onPaste, true);
        console.log('[WSS] WME search box hooks installed');
    }

    function boot() {
        sdk = unsafeWindow.getWmeSdk({ scriptId: SCRIPT_ID, scriptName: NAME });
        console.log('[WSS] SDK connected');
        const show = () => { buildPanel(); console.log('[WSS] panel ready'); };
        let ready = false;
        try { ready = !!(sdk.State && sdk.State.isReady && sdk.State.isReady()); } catch (e) { /* ignore */ }
        if (ready) show();
        else sdk.Events.once({ eventName: 'wme-ready' }).then(show);
    }
    // SDK_INITIALIZED may not exist yet if this script runs before WME sets it up.
    let tries = 0;
    (function waitForSdk() {
        if (unsafeWindow.SDK_INITIALIZED) { unsafeWindow.SDK_INITIALIZED.then(boot); return; }
        if (++tries > 150) { console.warn('[WSS] WME SDK not found'); return; }
        setTimeout(waitForSdk, 200);
    })();
})();
